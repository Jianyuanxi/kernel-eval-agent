# 后端配置模板。
# - 服务器：首次部署时 server_install.sh 复制到 /opt/kernel-eval/kernel-eval.env，并自动生成 KE_TOOL_TOKEN
# - 本机开发：复制成 backend/.env，删掉下面 3 行路径（默认用 backend/data/ 和仓库下的 samples/），按注释改（不要提交 .env）
KE_DATA_ROOT=/data/kernel-eval
KE_REF_ROOT=/data/kernel-eval/ref/os2024_exp_redo_kp
KE_SAMPLES_ROOT=/data/kernel-eval/samples
KE_SANDBOX_IMAGE=kernel-eval-sandbox:0.1

# Dify 调工具时带的令牌，和 Dify 自定义工具里填的 X-Tool-Token 一致
KE_TOOL_TOKEN=change-me
# Dify 智能体应用的 API 地址和密钥（Dify 应用 → 访问 API → API 密钥，app- 开头）
KE_DIFY_API_BASE=http://127.0.0.1:8080/v1
KE_DIFY_APP_KEY=
# 写进报告的模型名，和 Dify 应用里选的模型保持一致
KE_MODEL_NAME=deepseek/deepseek-flash

# 智能体评审总预算（首次、提醒、修正共用）和追问总预算，秒
KE_AGENT_TIMEOUT_S=420
KE_FOLLOWUP_TIMEOUT_S=60

# 用假数据顶替还没做好的模块：ingest,buildrun,analyze,diff,agent,scoring；all 表示全部；
# 不写这一行也是 all；全用真实模块时写成空值 KE_MOCK_MODULES=
KE_MOCK_MODULES=all
